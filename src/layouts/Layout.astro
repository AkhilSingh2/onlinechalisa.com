---
import '../styles/global.css';
import { getAlternateLinks, getLang } from '../i18n/utils';
import { LOCALE_META, DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hideHeader?: boolean;
}

const {
  title = 'Hanuman Chalisa Lyrics in Hindi, English, Telugu & Kannada · Online Chalisa',
  description = 'Read the Hanuman Chalisa lyrics in Hindi, English, Telugu, Kannada and Tamil in a distraction-free reader — plus Shiv, Ganesh, Durga, Shani, Laxmi and Saraswati Chalisa. Free, ad-free, no login, works offline.',
  keywords = 'Hanuman Chalisa, hanuman chalisa lyrics, hanuman chalisa in english, hanuman chalisa in hindi, hanuman chalisa telugu, hanuman chalisa in kannada, hanuman chalisa in tamil, shri hanuman chalisa, hariharan shree hanuman chalisa, hanuman chalisa paath, hanuman chalisa lyrics in hindi, hanuman chalisa lyrics in english, chalisa online, shiv chalisa, ganesh chalisa, durga chalisa, shani chalisa, laxmi chalisa, saraswati chalisa',
  image,
  ogType = 'website',
  noindex = false,
  jsonLd,
  hideHeader = false,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://onlinechalisa.com')).toString().replace(/\/$/, '');
// originPathname is the address the visitor opened. Astro.url is the
// English page it was rewritten onto, which would make every locale
// canonical point at the English URL.
const requestPath = (Astro.originPathname || Astro.url.pathname).replace(/\/$/, '') || '/';
const canonical = new URL(requestPath, siteOrigin + '/').toString();
const ogImage = new URL(image ?? '/og/default.png', siteOrigin + '/').toString();

const locale = getLang(Astro);
const localeMeta = LOCALE_META[locale];
const alternates = getAlternateLinks(Astro.url.pathname, siteOrigin);
const ogAltLocales = alternates
  .filter((a) => a.hreflang !== 'x-default' && a.locale !== locale)
  .map((a) => LOCALE_META[a.locale].ogLocale);

const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang={localeMeta.htmlLang} dir={localeMeta.dir} data-theme="light" data-script={localeMeta.defaultScript}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Online Chalisa" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />

    {/* hreflang alternates — one per locale plus x-default (English). */}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}


    <meta name="theme-color" content="#faf5ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0a07" media="(prefers-color-scheme: dark)" />

    {/* Favicon — svg preferred, ico fallback, PWA icons, Apple touch. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Online Chalisa" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {ogAltLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Online Chalisa — Hanuman Chalisa in Hindi, English, Telugu, Kannada & Tamil" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@onlinechalisa" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Online Chalisa — Hanuman Chalisa in Hindi, English, Telugu, Kannada & Tamil" />

    {/* JSON-LD structured data */}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif+Devanagari:wght@400;500;600&family=Noto+Serif+Telugu:wght@400;500;600&family=Noto+Serif+Tamil:wght@400;500;600&family=Noto+Serif+Kannada:wght@400;500;600&family=Noto+Serif+Bengali:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {/* Google Analytics (gtag.js) */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7PKERGW51P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7PKERGW51P');
    </script>

    {/* No-flash theme + script + scale boot — must run before body paints. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('oc-theme');
          var prefersDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          var scale = localStorage.getItem('oc-scale');
          if (scale) document.documentElement.style.setProperty('--reader-scale', scale);
          var script = localStorage.getItem('oc-script') || document.documentElement.getAttribute('data-script') || 'hi';
          document.documentElement.setAttribute('data-script', script);
          var translit = localStorage.getItem('oc-translit');
          if (translit === '1') document.documentElement.setAttribute('data-translit', 'on');
        } catch (e) {
          /* localStorage may be unavailable; fall back to defaults. */
        }
      })();
    </script>
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-(--surface) focus:px-3 focus:py-2 focus:text-sm focus:text-(--ink) focus:shadow-lg focus:ring-2 focus:ring-(--focus)"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
