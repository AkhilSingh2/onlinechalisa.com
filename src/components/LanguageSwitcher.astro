---
import Icon from './Icon.astro';
import { getLangFromUrl, localizePath } from '../i18n/utils';
import { LOCALES, LOCALE_META } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const path = Astro.url.pathname;
---

{/* Language switcher — a keyboard/no-JS friendly <details> menu whose
    items are real anchor links to the same page in each locale, so
    search engines can crawl every localized alternate. */}
<details class="oc-lang relative" data-lang-switcher>
  <summary
    class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full border border-(--hairline) bg-(--surface) px-2.5 text-(--ink) transition hover:border-(--hairline-strong) [&::-webkit-details-marker]:hidden"
    aria-label={t('lang.choose')}
    title={t('lang.switcher')}
  >
    <Icon name="lang" size={16} />
    <span class="text-[13px] font-medium">{LOCALE_META[current].native}</span>
  </summary>

  <div
    class="absolute right-0 z-50 mt-2 w-44 overflow-hidden rounded-xl border border-(--hairline) bg-(--surface) p-1 shadow-lg"
    role="menu"
    aria-label={t('lang.switcher')}
  >
    {LOCALES.map((loc) => (
      <a
        href={localizePath(path, loc)}
        role="menuitem"
        hreflang={LOCALE_META[loc].htmlLang}
        aria-current={loc === current ? 'true' : undefined}
        class:list={[
          'flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm transition',
          loc === current
            ? 'bg-(--surface-soft) font-medium text-(--ink)'
            : 'text-(--body) hover:bg-(--surface-soft) hover:text-(--ink)',
        ]}
      >
        <span>{LOCALE_META[loc].native}</span>
        {loc === current && <Icon name="check" size={14} class="text-(--accent)" />}
      </a>
    ))}
  </div>
</details>

<script is:inline>
  (function () {
    // Close any open language menu on outside click or Escape.
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details[data-lang-switcher][open]').forEach((d) => {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document
          .querySelectorAll('details[data-lang-switcher][open]')
          .forEach((d) => d.removeAttribute('open'));
      }
    });
  })();
</script>
