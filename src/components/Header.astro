---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { LIBRARY } from '../lib/library';
import { getLang, localizePath, stripLocale, useTranslations } from '../i18n/utils';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const canonicalPath = stripLocale(Astro.url.pathname);
const lp = (p: string) => localizePath(p, lang);
const onSankalp = canonicalPath.startsWith('/sankalp');
const linkClass =
  'text-sm text-(--body) hover:text-(--ink) transition-colors duration-200 rounded-full px-3 py-1.5';
const libraryOpen = LIBRARY.some((group) => group.items.some((item) => item.href === canonicalPath));
---

<header
  class:list={[
    'zen-hide sticky top-0 z-40 backdrop-blur-md',
    'bg-[color-mix(in_oklab,var(--canvas)_82%,transparent)]',
    'border-b border-(--hairline)',
  ]}
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-3 sm:h-[68px] sm:px-6">
    <a
      href={lp('/')}
      class="group flex min-w-0 items-center gap-2.5 rounded-md py-1"
      aria-label={t('header.homeAria')}
    >
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-(--accent-soft) text-(--accent) transition-transform duration-300 group-hover:rotate-[-6deg]"
      >
        <img src="/diya.svg" alt="" width="20" height="20" class="opacity-95" />
      </span>
      <span class="truncate font-serif text-[19px] font-medium tracking-tight text-(--ink) sm:text-[20px]">
        Online<span class="text-(--accent)"> Chalisa</span>
      </span>
    </a>

    {
      !minimal && (
        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          <button
            type="button"
            id="library-toggle"
            class:list={[
              'inline-flex cursor-pointer items-center gap-1 rounded-full px-3 py-1.5 text-sm transition-colors duration-200',
              libraryOpen ? 'bg-(--accent-soft) text-(--accent)' : 'text-(--body) hover:text-(--ink)',
            ]}
            aria-expanded="false"
            aria-controls="site-menu"
            aria-haspopup="true"
          >
            {t('menu.library')}
            <svg data-library-chevron width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <a href={lp('/sankalp')} class={linkClass} aria-current={onSankalp ? 'page' : undefined}>{t('nav.sankalp')}</a>
          <a href={lp('/about')} class={linkClass}>{t('nav.about')}</a>
        </nav>
      )
    }

    <div class="flex items-center gap-2">
      {
        !minimal && (
          <button
            type="button"
            id="nav-toggle"
            class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-(--hairline) bg-(--surface) text-(--ink) md:hidden"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label={t('header.menu')}
            data-label-open={t('header.menu')}
            data-label-close={t('header.closeMenu')}
          >
            <span data-nav-icon="open"><Icon name="menu" size={16} /></span>
            <span data-nav-icon="close" class="hidden"><Icon name="close" size={16} /></span>
          </button>
        )
      }

      <LanguageSwitcher />

      <button
        type="button"
        id="theme-toggle"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-(--hairline) bg-(--surface) text-(--ink) transition hover:border-(--hairline-strong)"
        aria-label={t('header.themeCycle')}
        title={t('header.themeCycleTitle')}
      >
        <span data-theme-icon="light"><Icon name="sun" size={16} /></span>
        <span data-theme-icon="sepia" class="hidden"><Icon name="sepia" size={16} /></span>
        <span data-theme-icon="dark" class="hidden"><Icon name="moon" size={16} /></span>
      </button>

      {
        !minimal && (
          <a
            href={onSankalp ? lp('/') + '#chalisas' : lp('/sankalp')}
            class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-(--ink) px-4 py-1.5 text-[13px] font-medium text-(--canvas) transition hover:opacity-90"
          >
            {onSankalp ? t('header.startReading') : t('header.beginSankalp')}
            <Icon name="arrow" size={14} />
          </a>
        )
      }
    </div>
  </div>

  {
    !minimal && (
      <div
        id="site-menu"
        hidden
        class="absolute inset-x-0 top-full z-30 max-h-[min(34rem,calc(100dvh-4.25rem))] overflow-y-auto border-b border-(--hairline) bg-(--canvas) pb-24 shadow-[0_18px_40px_-24px_rgba(42,30,17,0.45)] md:pb-0"
      >
        <div class="mx-auto grid max-w-6xl gap-x-6 gap-y-5 px-4 py-5 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
          {LIBRARY.map((group) => (
            <section>
              <h2 class="flex items-center gap-2.5 font-serif text-[17px] font-medium text-(--ink)">
                <img src={group.art} alt="" width="40" height="40" class="h-10 w-10 rounded-full object-cover shadow-[0_0_0_1px_var(--hairline)]" />
                {t(`menu.deity.${group.id}`)}
              </h2>
              <ul class="mt-2 space-y-0.5 pl-[50px]">
                {group.items.map((item) => {
                  const current = item.href === canonicalPath;
                  return (
                    <li>
                      <a
                        href={lp(item.href)}
                        aria-current={current ? 'page' : undefined}
                        class:list={[
                          'block rounded-lg px-2 py-1.5 text-sm transition-colors',
                          current
                            ? 'bg-(--surface) font-medium text-(--ink) ring-1 ring-(--accent)'
                            : 'text-(--body) hover:bg-(--surface-soft) hover:text-(--ink)',
                        ]}
                      >
                        {t(item.titleKey)}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
        <div class="mx-auto flex max-w-6xl gap-2 border-t border-(--hairline) px-4 py-3 md:hidden sm:px-6">
          <a href={lp('/sankalp')} class="rounded-full px-3 py-1.5 text-sm text-(--ink)">{t('nav.sankalp')}</a>
          <a href={lp('/about')} class="rounded-full px-3 py-1.5 text-sm text-(--ink)">{t('nav.about')}</a>
        </div>
      </div>
    )
  }
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const order = ['light', 'sepia', 'dark'];
    function paint(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('oc-theme', theme);
      } catch (e) {}
      document.querySelectorAll('[data-theme-icon]').forEach((el) => {
        el.classList.toggle('hidden', el.getAttribute('data-theme-icon') !== theme);
      });
    }
    const initial = document.documentElement.getAttribute('data-theme') || 'light';
    paint(initial);
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = order[(order.indexOf(current) + 1) % order.length];
      paint(next);
    });
  })();

  (function () {
    const panel = document.getElementById('site-menu');
    const toggles = [document.getElementById('nav-toggle'), document.getElementById('library-toggle')].filter(Boolean);
    if (!panel || toggles.length === 0) return;
    const navToggle = document.getElementById('nav-toggle');
    const openIcon = navToggle?.querySelector('[data-nav-icon="open"]');
    const closeIcon = navToggle?.querySelector('[data-nav-icon="close"]');
    const openLabel = navToggle?.getAttribute('data-label-open') || 'Menu';
    const closeLabel = navToggle?.getAttribute('data-label-close') || 'Close menu';
    const chevron = document.querySelector('[data-library-chevron]');

    function setOpen(open) {
      panel.hidden = !open;
      toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(open)));
      if (navToggle) navToggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      chevron?.classList.toggle('rotate-180', open);
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        setOpen(panel.hidden);
      });
    });
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        // Hide after the click, so the browser can still follow the link.
        setTimeout(() => setOpen(false), 0);
      });
    });
    document.addEventListener('click', (event) => {
      if (panel.hidden) return;
      if (panel.contains(event.target)) return;
      setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>
