---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLang, localizePath, stripLocale, useTranslations } from '../i18n/utils';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const canonicalPath = stripLocale(Astro.url.pathname);
const lp = (p: string) => localizePath(p, lang);
const onSankalp = canonicalPath.startsWith('/sankalp');
const onPaath = canonicalPath.startsWith('/paath');
const linkClass =
  'text-sm text-(--body) hover:text-(--ink) transition-colors duration-200 rounded-full px-3 py-1.5';
---

<header
  class:list={[
    'zen-hide sticky top-0 z-40 backdrop-blur-md',
    'bg-[color-mix(in_oklab,var(--canvas)_82%,transparent)]',
    'border-b border-(--hairline)',
    'relative',
  ]}
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-3 sm:h-[68px] sm:px-6">
    <a
      href="/"
      class="group flex min-w-0 items-center gap-2.5 rounded-md py-1"
      aria-label={t('header.homeAria')}
    >
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-(--accent-soft) text-(--accent) transition-transform duration-300 group-hover:rotate-[-6deg]"
      >
        <img src="/diya.svg" alt="" width="20" height="20" class="opacity-95" />
      </span>
      <span class="truncate font-serif text-[19px] font-medium tracking-tight text-(--ink) sm:text-[20px]">
        Online<span class="text-(--accent)"> Chalisa</span>
      </span>
    </a>

    {
      !minimal && (
        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          <a href={lp('/') + '#chalisas'} class={linkClass}>{t('nav.chalisas')}</a>
          <a href={lp('/') + '#paath'} class={linkClass} aria-current={onPaath ? 'page' : undefined}>{t('nav.paath')}</a>
          <a href={lp('/sankalp')} class={linkClass}>{t('nav.sankalp')}</a>
          <a href={lp('/about')} class={linkClass}>{t('nav.about')}</a>
        </nav>
      )
    }

    <div class="flex items-center gap-2">
      {
        !minimal && (
          <button
            type="button"
            id="nav-toggle"
            class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-(--hairline) bg-(--surface) text-(--ink) md:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label={t('header.menu')}
            data-label-open={t('header.menu')}
            data-label-close={t('header.closeMenu')}
          >
            <span data-nav-icon="open"><Icon name="menu" size={16} /></span>
            <span data-nav-icon="close" class="hidden"><Icon name="close" size={16} /></span>
          </button>
        )
      }

      <LanguageSwitcher />

      <button
        type="button"
        id="theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-(--hairline) bg-(--surface) text-(--ink) transition hover:border-(--hairline-strong)"
        aria-label={t('header.themeCycle')}
        title={t('header.themeCycleTitle')}
      >
        <span data-theme-icon="light"><Icon name="sun" size={16} /></span>
        <span data-theme-icon="sepia" class="hidden"><Icon name="sepia" size={16} /></span>
        <span data-theme-icon="dark" class="hidden"><Icon name="moon" size={16} /></span>
      </button>

      {
        !minimal && (
          <a
            href={onSankalp ? lp('/') + '#chalisas' : lp('/sankalp')}
            class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-(--ink) px-4 py-1.5 text-[13px] font-medium text-(--canvas) transition hover:opacity-90"
          >
            {onSankalp ? t('header.startReading') : t('header.beginSankalp')}
            <Icon name="arrow" size={14} />
          </a>
        )
      }
    </div>
  </div>

  {
    !minimal && (
      <nav
        id="mobile-nav"
        class="absolute inset-x-0 top-full hidden border-b border-(--hairline) bg-(--canvas) px-3 py-2 md:hidden"
        aria-label="Primary"
      >
        <a href={lp('/') + '#chalisas'} class="block rounded-lg px-3 py-2.5 text-sm text-(--ink)">{t('nav.chalisas')}</a>
        <a href={lp('/') + '#paath'} class="block rounded-lg px-3 py-2.5 text-sm text-(--ink)" aria-current={onPaath ? 'page' : undefined}>{t('nav.paath')}</a>
        <a href={lp('/sankalp')} class="block rounded-lg px-3 py-2.5 text-sm text-(--ink)">{t('nav.sankalp')}</a>
        <a href={lp('/about')} class="block rounded-lg px-3 py-2.5 text-sm text-(--ink)">{t('nav.about')}</a>
      </nav>
    )
  }
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const order = ['light', 'sepia', 'dark'];
    function paint(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('oc-theme', theme);
      } catch (e) {}
      document.querySelectorAll('[data-theme-icon]').forEach((el) => {
        el.classList.toggle('hidden', el.getAttribute('data-theme-icon') !== theme);
      });
    }
    const initial = document.documentElement.getAttribute('data-theme') || 'light';
    paint(initial);
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = order[(order.indexOf(current) + 1) % order.length];
      paint(next);
    });
  })();

  (function () {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;
    const openIcon = toggle.querySelector('[data-nav-icon="open"]');
    const closeIcon = toggle.querySelector('[data-nav-icon="close"]');
    const openLabel = toggle.getAttribute('data-label-open') || 'Menu';
    const closeLabel = toggle.getAttribute('data-label-close') || 'Close menu';
    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    }
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
