---
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  /** The short line already shown under the hymn title. */
  blurb: string;
  url: string;
}

const { title, blurb, url } = Astro.props;
const t = useTranslations(getLang(Astro));
const message = ['🙏 ' + title, '', blurb, '', t('share.blessing'), url].join('\n');
const whatsapp = `https://wa.me/?text=${encodeURIComponent(message)}`;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const iconClass =
  'grid h-9 w-9 cursor-pointer place-items-center rounded-full text-white transition hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--focus)';
---

<div
  class="zen-hide fixed right-3 z-40 sm:right-5"
  style="bottom: calc(5.6rem + env(safe-area-inset-bottom));"
>
  <div
    class="flex items-center gap-1.5 rounded-full border border-(--hairline) bg-[color-mix(in_oklab,var(--surface)_92%,transparent)] py-1 pl-3 pr-1 shadow-[var(--shadow-float)] backdrop-blur-md"
  >
    <span class="pr-0.5 text-[12px] font-medium text-(--body)">{t('share.label')}</span>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class={`${iconClass} bg-[#25D366]`}
      aria-label={`WhatsApp`}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        ></path>
      </svg>
    </a>
    <a
      href={facebook}
      target="_blank"
      rel="noopener noreferrer"
      class={`${iconClass} bg-[#1877F2]`}
      aria-label="Facebook"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path
          d="M14.5 8.5V6.8c0-.7.5-1 1.1-1h1.4V3h-2.4C11.8 3 11 4.6 11 6.6v1.9H9v2.8h2V21h3.5v-9.7h2.3l.4-2.8h-2.7z"
        ></path>
      </svg>
    </a>
    <button
      type="button"
      id="share-instagram"
      class={`${iconClass} bg-[#E1306C]`}
      aria-label="Instagram"
      data-message={message}
      data-copied={t('share.instagramCopied')}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="4" y="4" width="16" height="16" rx="5"></rect>
        <circle cx="12" cy="12" r="3.5"></circle>
        <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"></circle>
      </svg>
    </button>
  </div>
  <p
    id="share-instagram-note"
    hidden
    class="mt-1.5 max-w-[14rem] rounded-xl bg-(--ink) px-3 py-2 text-right text-[12px] leading-snug text-(--canvas) shadow-lg"
    role="status"
  >
  </p>
</div>

<script is:inline>
  (function () {
    const btn = document.getElementById('share-instagram');
    const note = document.getElementById('share-instagram-note');
    if (!btn || !note) return;
    let timer = 0;
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-message') || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {}
      note.textContent = btn.getAttribute('data-copied') || '';
      note.hidden = false;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        note.hidden = true;
      }, 3200);
    });
  })();
</script>
