---
import Icon from './Icon.astro';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  slug: string;
  audioUrl?: string;
}

const { title, slug, audioUrl } = Astro.props;
const timingsUrl = audioUrl ? audioUrl.replace(/\.mp3$/, '.json') : '';

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<div
  class="audio-dock zen-reveal fixed inset-x-0 bottom-0 z-40 border-t border-(--hairline) bg-[color-mix(in_oklab,var(--surface)_92%,transparent)] backdrop-blur-md"
  aria-label={t('audio.player')}
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="mx-auto flex max-w-3xl items-center gap-3 px-3 py-3 sm:px-6">
    <button
      type="button"
      id="audio-play"
      class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full bg-(--ink) text-(--canvas) transition hover:scale-105 disabled:cursor-not-allowed disabled:opacity-50"
      aria-label={t('audio.playPause')}
    >
      <span data-audio-icon="play"><Icon name="play" size={16} /></span>
      <span data-audio-icon="pause" class="hidden"><Icon name="pause" size={16} /></span>
    </button>

    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-2 text-xs text-(--body)">
        <span class="min-w-0 truncate font-medium text-(--ink)">{title}</span>
        <span class="shrink-0 font-mono text-[11px] text-(--mute)">
          <span id="audio-current">0:00</span> / <span id="audio-total">0:00</span>
        </span>
      </div>
      <div
        id="audio-track"
        class="relative mt-1.5 h-1 cursor-pointer rounded-full bg-(--hairline)"
        role="slider"
        aria-label={t('audio.seek')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        tabindex="0"
      >
        <div id="audio-fill" class="absolute inset-y-0 left-0 rounded-full bg-(--accent)" style="width: 0%"></div>
      </div>
      {
        audioUrl && (
          <p class="mt-1 truncate text-[10px] text-(--mute)">{t('audio.recitation')}</p>
        )
      }
      {
        !audioUrl && (
          <p class="mt-1 text-[11px] text-(--mute)">
            {t('audio.comingSoon')}
          </p>
        )
      }
      {
        audioUrl && (
          <p id="audio-missing-note" class="mt-1 hidden text-[11px] text-(--mute)">
            {t('audio.comingSoon')}
          </p>
        )
      }
    </div>
  </div>

  <audio id="audio-el" preload="metadata" src={audioUrl}></audio>
</div>

<script is:inline define:vars={{ slug, timingsUrl }}>
  (function () {
    const audio = document.getElementById('audio-el');
    const btn = document.getElementById('audio-play');
    const fill = document.getElementById('audio-fill');
    const track = document.getElementById('audio-track');
    const cur = document.getElementById('audio-current');
    const tot = document.getElementById('audio-total');
    if (!audio || !btn) return;
    const hasSrc = !!audio.getAttribute('src');
    if (!hasSrc) btn.disabled = true;

    // If a src is configured but the file can't be loaded (e.g. not yet
    // uploaded to /public/audio, or a network failure), degrade gracefully:
    // disable the control and show the "coming soon" note instead of a
    // dead button that silently does nothing.
    audio.addEventListener('error', () => {
      btn.disabled = true;
      const note = document.getElementById('audio-missing-note');
      if (note) note.classList.remove('hidden');
    });

    function fmt(s) {
      if (!isFinite(s)) return '0:00';
      s = Math.floor(s);
      const m = Math.floor(s / 60);
      const r = s % 60;
      return m + ':' + String(r).padStart(2, '0');
    }
    function setIcon(playing) {
      document
        .querySelector('[data-audio-icon="play"]')
        ?.classList.toggle('hidden', playing);
      document
        .querySelector('[data-audio-icon="pause"]')
        ?.classList.toggle('hidden', !playing);
    }
    function track_(name) {
      if (typeof window.gtag === 'function') window.gtag('event', name, { chalisa: slug });
    }

    // ─── Verse sync ──────────────────────────────────────
    let timings = [];
    let activeIdx = -1;
    let playedOnce = false;
    let lastManualScroll = 0;
    const reader = document.querySelector('.reader');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (timingsUrl) {
      fetch(timingsUrl)
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (!data || !Array.isArray(data.verses)) return;
          timings = data.verses;
          reader?.setAttribute('data-recitation', 'ready');
        })
        .catch(() => {});
    }

    function verseAt(t) {
      let idx = -1;
      for (let k = 0; k < timings.length; k++) {
        if (timings[k].start <= t) idx = timings[k].i;
        else break;
      }
      return idx;
    }
    function highlight(idx) {
      if (idx === activeIdx) return;
      document.getElementById('v-' + activeIdx)?.classList.remove('is-reciting');
      activeIdx = idx;
      const el = document.getElementById('v-' + idx);
      if (!el) return;
      el.classList.add('is-reciting');
      // Follow the recitation, but don't yank the page while the reader is
      // scrolling around on their own.
      if (!audio.paused && performance.now() - lastManualScroll > 4000) {
        el.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    }
    window.addEventListener('wheel', () => (lastManualScroll = performance.now()), { passive: true });
    window.addEventListener('touchmove', () => (lastManualScroll = performance.now()), { passive: true });

    // Tap a verse to jump there — only once the listener has started the
    // recitation, so plain readers can still tap and select text freely.
    document.querySelectorAll('.reader .verse').forEach((el) => {
      el.addEventListener('click', () => {
        if (!timings.length || !playedOnce) return;
        if (String(window.getSelection?.() || '').length > 0) return;
        const idx = Number(el.id.replace('v-', ''));
        const entry = timings.find((x) => x.i === idx);
        if (!entry) return;
        audio.currentTime = entry.start;
        lastManualScroll = 0;
        if (audio.paused) audio.play();
      });
    });

    btn.addEventListener('click', () => {
      if (!audio.getAttribute('src')) return;
      if (audio.paused) audio.play();
      else audio.pause();
    });
    audio.addEventListener('play', () => {
      setIcon(true);
      // The teleprompter would fight the verse-following scroll.
      document.dispatchEvent(new CustomEvent('oc:recitation-play'));
      if (!playedOnce) {
        playedOnce = true;
        track_('recitation_play');
      }
    });
    audio.addEventListener('pause', () => setIcon(false));
    audio.addEventListener('ended', () => {
      track_('recitation_complete');
      document.getElementById('v-' + activeIdx)?.classList.remove('is-reciting');
      activeIdx = -1;
      document.dispatchEvent(new CustomEvent('oc:recitation-complete'));
    });
    audio.addEventListener('loadedmetadata', () => {
      tot.textContent = fmt(audio.duration);
    });
    audio.addEventListener('timeupdate', () => {
      cur.textContent = fmt(audio.currentTime);
      const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      fill.style.width = pct + '%';
      track.setAttribute('aria-valuenow', String(Math.round(pct)));
      if (timings.length && !audio.ended) highlight(verseAt(audio.currentTime));
    });
    function seekFromEvent(e) {
      const rect = track.getBoundingClientRect();
      const x = ('touches' in e ? e.touches[0].clientX : e.clientX) - rect.left;
      const pct = Math.max(0, Math.min(1, x / rect.width));
      if (audio.duration) audio.currentTime = pct * audio.duration;
    }
    track.addEventListener('click', seekFromEvent);
    track.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      if (e.key === 'ArrowRight') audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
      if (e.key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        audio.paused ? audio.play() : audio.pause();
      }
    });
  })();
</script>
