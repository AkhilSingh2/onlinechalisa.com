---
import Icon from './Icon.astro';

interface Props {
  slug: string;
  title: string;
  deity: string;
  tagline: string;
  tradition?: string;
  color?: string;
  order: number;
  verseCount?: number;
}

const {
  slug,
  title,
  deity,
  tagline,
  tradition,
  color = '#c96a1a',
  order,
  verseCount,
} = Astro.props;
const num = String(order).padStart(2, '0');

// Rough reading estimate: ~30s per verse read aloud at a devotional pace.
const readMin = verseCount ? Math.max(3, Math.round((verseCount * 30) / 60)) : 7;
const meta = verseCount
  ? `${verseCount} verses · ~${readMin} min`
  : '40 verses · ~7 min';
---

<a
  href={`/chalisa/${slug}`}
  class="surface-card group relative flex flex-col gap-5 p-6 focus:outline-none"
  aria-label={`Read ${title}`}
>
  <div class="flex items-start justify-between">
    <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-(--mute)">
      {num} · {tradition ?? deity}
    </span>
    <span
      class="grid h-8 w-8 place-items-center rounded-full transition-transform duration-500 group-hover:rotate-6"
      style={`background: color-mix(in oklab, ${color} 14%, transparent); color: ${color};`}
      aria-hidden="true"
    >
      <Icon name="diya" size={16} />
    </span>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="font-serif text-2xl font-medium tracking-tight text-(--ink)">
      {title}
    </h3>
    <p class="text-[15px] leading-relaxed text-(--body)">{tagline}</p>
  </div>

  <div class="mt-auto flex items-center justify-between pt-2">
    <span class="text-xs text-(--mute)">{meta}</span>
    <span
      class="inline-flex items-center gap-1 text-sm font-medium text-(--ink) opacity-70 transition-opacity group-hover:opacity-100"
    >
      Read
      <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
