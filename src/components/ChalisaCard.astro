---
import Icon from './Icon.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  slug: string;
  title: string;
  deity: string;
  tagline: string;
  tradition?: string;
  color?: string;
  order: number;
  verseCount?: number;
}

const {
  slug,
  title,
  deity,
  tagline,
  tradition,
  color = '#c96a1a',
  order,
  verseCount,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const num = String(order).padStart(2, '0');

// Localized card copy — falls back to the English content prop when a
// locale has no override (`t()` returns the key unchanged if unknown).
const taglineKey = `card.tagline.${slug}`;
const traditionKey = `card.tradition.${slug}`;
const localTagline = t(taglineKey) === taglineKey ? tagline : t(taglineKey);
const traditionEn = tradition ?? deity;
const localTradition = t(traditionKey) === traditionKey ? traditionEn : t(traditionKey);

// Rough reading estimate: ~30s per verse read aloud at a devotional pace.
const readMin = verseCount ? Math.max(3, Math.round((verseCount * 30) / 60)) : 7;
const count = verseCount ?? 40;
const mins = verseCount ? readMin : 7;
const meta = `${count} ${t('card.verses')} · ~${mins} ${t('card.min')}`;
---

<a
  href={localizePath(`/chalisa/${slug}`, lang)}
  class="surface-card group relative flex flex-col gap-5 p-6 focus:outline-none"
  aria-label={`${t('card.readPrefix')} ${title}`}
>
  <div class="flex items-start justify-between">
    <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-(--mute)">
      {num} · {localTradition}
    </span>
    <span
      class="grid h-8 w-8 place-items-center rounded-full transition-transform duration-500 group-hover:rotate-6"
      style={`background: color-mix(in oklab, ${color} 14%, transparent); color: ${color};`}
      aria-hidden="true"
    >
      <Icon name="diya" size={16} />
    </span>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="font-serif text-2xl font-medium tracking-tight text-(--ink)">
      {title}
    </h3>
    <p class="text-[15px] leading-relaxed text-(--body)">{localTagline}</p>
  </div>

  <div class="mt-auto flex items-center justify-between pt-2">
    <span class="text-xs text-(--mute)">{meta}</span>
    <span
      class="inline-flex items-center gap-1 text-sm font-medium text-(--ink) opacity-70 transition-opacity group-hover:opacity-100"
    >
      {t('card.read')}
      <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
