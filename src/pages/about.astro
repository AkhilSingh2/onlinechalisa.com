---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t('about.metaTitle')}
  description={t('about.metaDescription')}
>
  <Header />

  <main id="main" class="pb-24">
    <article class="mx-auto max-w-2xl px-5 pt-16 sm:px-6 sm:pt-24">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('about.kicker')}</p>
      <h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight text-(--ink) sm:text-5xl">
        {t('about.heading')}
      </h1>

      <div class="reader mt-8 space-y-6 text-(--body)">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">{t('about.noDo.heading')}</h2>
        <ul class="space-y-2 pl-5">
          <li class="list-disc">{t('about.noDo.1')}</li>
          <li class="list-disc">{t('about.noDo.2')}</li>
          <li class="list-disc">{t('about.noDo.3')}</li>
          <li class="list-disc">{t('about.noDo.4')}</li>
        </ul>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">{t('about.sankalp.heading')}</h2>
        <p>{t('about.sankalp.body')}</p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">{t('about.text.heading')}</h2>
        <p>{t('about.text.body')}</p>

        <p class="pt-4 text-center font-serif text-lg text-(--ink)">
          {t('about.blessing')}
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
