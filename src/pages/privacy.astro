---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, localizePath } from '../i18n/utils';

const lastUpdated = 'July 2026';
const lp = (p: string) => localizePath(p, getLangFromUrl(Astro.url));
---

<Layout
  title="Privacy Policy · Online Chalisa"
  description="How Online Chalisa handles your data — no accounts, no tracking, no third-party analytics. Everything stays on your device."
>
  <Header />

  <main id="main" class="pb-24">
    <article class="mx-auto max-w-2xl px-5 pt-16 sm:px-6 sm:pt-24">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">Privacy Policy</p>
      <h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight text-(--ink) sm:text-5xl">
        Your practice is yours alone.
      </h1>
      <p class="mt-4 text-sm text-(--mute)">Last updated: {lastUpdated}</p>

      <div class="reader mt-8 space-y-6 text-(--body)">
        <p>
          Online Chalisa is designed to be a quiet, private reader for sacred hymns. We do not
          want your data, we do not sell your data, and we have gone out of our way to make sure
          we never collect it in the first place.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">What we don't collect</h2>
        <ul class="space-y-2 pl-5">
          <li class="list-disc">No accounts, sign-ups, or email addresses.</li>
          <li class="list-disc">No third-party analytics, pixels, or advertising trackers.</li>
          <li class="list-disc">No cookies used for tracking or profiling.</li>
          <li class="list-disc">No behavioural profiles, no ad targeting, no data brokers.</li>
        </ul>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">What stays on your device</h2>
        <p>
          A few small preferences are saved in your browser's <code class="rounded bg-(--surface-soft) px-1.5 py-0.5 font-mono text-[13px]">localStorage</code>
          so the reader feels the same each visit. These values never leave your device and are
          never transmitted to us:
        </p>
        <ul class="space-y-2 pl-5">
          <li class="list-disc"><strong class="text-(--ink)">oc-theme</strong> — your chosen theme (light, sepia, dark).</li>
          <li class="list-disc"><strong class="text-(--ink)">oc-script</strong> — your preferred script (Hindi, Telugu, Tamil, Kannada, English).</li>
          <li class="list-disc"><strong class="text-(--ink)">oc-translit</strong> — whether the English transliteration line is shown.</li>
          <li class="list-disc"><strong class="text-(--ink)">oc-scale</strong> — your font size preference.</li>
          <li class="list-disc"><strong class="text-(--ink)">oc-sankalp-v1</strong> — your Sankalp streak (start date, length, completed days).</li>
        </ul>
        <p>
          Clearing your browser data will erase these values. That is the price of privacy, and
          we think it is a fair one.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Server logs</h2>
        <p>
          Like most websites, our hosting provider automatically records basic technical
          information about incoming requests (IP address, user-agent, requested URL, timestamp)
          for a short period, purely to keep the site running and to defend against abuse. This
          information is not used to build profiles of individuals and is not sold or shared.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Third-party resources</h2>
        <p>
          The reader loads devotional fonts from Google Fonts to render Devanagari, Telugu, Tamil
          and Kannada correctly. Loading a font makes a request to Google's servers; we have no
          control over the data Google receives from those requests, and encourage you to review
          <a
            class="underline decoration-(--hairline-strong) underline-offset-4 hover:text-(--ink)"
            href="https://policies.google.com/privacy"
            rel="noopener noreferrer"
            target="_blank">Google's privacy policy</a
          > if this is a concern.
        </p>
        <p>
          Audio recitations, where available, are streamed from public, well-known audio hosts.
          Those hosts may log requests they receive. No listening data is sent back to Online
          Chalisa.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Children</h2>
        <p>
          Online Chalisa is a devotional resource with no accounts, comments, or user-generated
          content. It is suitable for all ages. We do not knowingly collect information from
          anyone, including children.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Changes to this policy</h2>
        <p>
          If we ever change how Online Chalisa handles data, this page will be updated and the
          date at the top revised. We will not add tracking or advertising without disclosing it
          plainly, and we do not intend to.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Contact</h2>
        <p>
          If you have a question about privacy on this site, please reach out through the
          <a class="underline decoration-(--hairline-strong) underline-offset-4 hover:text-(--ink)" href={lp('/about')}>About page</a>.
        </p>

        <p class="pt-4 text-center font-serif text-lg text-(--ink)">
          ॥ शुभम् अस्तु ॥
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
