---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReaderControls from '../../components/ReaderControls.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import Icon from '../../components/Icon.astro';
import ShareWhatsApp from '../../components/ShareWhatsApp.astro';
import DeityMark from '../../components/DeityMark.astro';
import RecitationNext from '../../components/RecitationNext.astro';
import { getCollection } from 'astro:content';
import { transliterate } from '../../lib/transliterate';
import { romanize } from '../../lib/romanize';
import { getPaathCopy } from '../../lib/paath-copy';
import { CONTENT_UPDATED } from '../../lib/content-updated';
import { getLang, localizePath, useTranslations } from '../../i18n/utils';

// Paath = bhajans, kavach, ashtak and other texts that are not chalisas.
const all = (await getCollection('paath')).sort((a, b) => a.data.order - b.data.order);
const entry = all.find((item) => item.data.slug === Astro.params.slug);

if (!entry) {
  return Astro.redirect('/404', 302);
}

const { data } = entry;

const lang = getLang(Astro);
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const copy = getPaathCopy(data.slug, lang);

const titleKey = `paath.title.${data.slug}`;
const localTitle = t(titleKey) === titleKey ? data.title : t(titleKey);
const taglineKey = `card.tagline.${data.slug}`;
const localTagline = t(taglineKey) === taglineKey ? (copy?.tagline ?? data.tagline) : t(taglineKey);
const localTradition = data.tradition ?? data.deity;
const titleOf = (e: (typeof all)[number]) => {
  const key = `paath.title.${e.data.slug}`;
  return t(key) === key ? e.data.title : t(key);
};
const labelOf = (key: string) => (t(key) === key ? key : t(key));

const idx = all.findIndex((e) => e.data.slug === data.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const scripts = [
  { code: 'hi', klass: 'script-hi', text: (hi: string) => hi },
  { code: 'te', klass: 'script-te', text: (hi: string) => transliterate(hi, 'telugu') },
  { code: 'ta', klass: 'script-ta', text: (hi: string) => transliterate(hi, 'tamil') },
  { code: 'kn', klass: 'script-kn', text: (hi: string) => transliterate(hi, 'kannada') },
  { code: 'bn', klass: 'script-bn', text: (hi: string) => transliterate(hi, 'bengali') },
] as const;

const opening = data.verses[0];

// The chalisa this paath belongs with, plus the sibling hymn.
const parentBySlug: Record<string, { href: string; labelKey: string }> = {
  'bajrang-baan': { href: '/chalisa/hanuman', labelKey: 'chalisa.title.hanuman' },
  'sankat-mochan-hanuman-ashtak': { href: '/chalisa/hanuman', labelKey: 'chalisa.title.hanuman' },
  'hanuman-aarti': { href: '/chalisa/hanuman', labelKey: 'chalisa.title.hanuman' },
  'durga-kavach': { href: '/chalisa/durga', labelKey: 'chalisa.title.durga' },
  'durga-aarti': { href: '/chalisa/durga', labelKey: 'chalisa.title.durga' },
  'ganesh-aarti': { href: '/chalisa/ganesh', labelKey: 'chalisa.title.ganesh' },
  'satyanarayan-aarti': { href: '/chalisa/laxmi', labelKey: 'chalisa.title.laxmi' },
};
const siblingBySlug: Record<string, { href: string; labelKey: string }[]> = {
  'bajrang-baan': [
    { href: '/paath/hanuman-aarti', labelKey: 'paath.title.hanuman-aarti' },
    { href: '/paath/sankat-mochan-hanuman-ashtak', labelKey: 'paath.title.sankat-mochan-hanuman-ashtak' },
  ],
  'sankat-mochan-hanuman-ashtak': [
    { href: '/paath/hanuman-aarti', labelKey: 'paath.title.hanuman-aarti' },
    { href: '/paath/bajrang-baan', labelKey: 'paath.title.bajrang-baan' },
  ],
  'hanuman-aarti': [
    { href: '/paath/bajrang-baan', labelKey: 'paath.title.bajrang-baan' },
  ],
  'durga-kavach': [
    { href: '/paath/durga-aarti', labelKey: 'paath.title.durga-aarti' },
  ],
  'durga-aarti': [
    { href: '/paath/durga-kavach', labelKey: 'paath.title.durga-kavach' },
  ],
  'om-jai-jagdish-hare': [
    { href: '/paath/satyanarayan-aarti', labelKey: 'paath.title.satyanarayan-aarti' },
  ],
  'satyanarayan-aarti': [
    { href: '/paath/om-jai-jagdish-hare', labelKey: 'paath.title.om-jai-jagdish-hare' },
  ],
};
const parent = parentBySlug[data.slug];
const related = [
  ...(parent ? [{ href: parent.href, label: labelOf(parent.labelKey) }] : []),
  ...(siblingBySlug[data.slug] ?? []).map((item) => ({ href: item.href, label: labelOf(item.labelKey) })),
];
const continueTo = related[1] ?? related[0] ?? { href: '/sankalp', label: t('after.sankalp') };

const siteUrl = 'https://onlinechalisa.com';
const url = `${siteUrl}/paath/${data.slug}`;
const originPath = (Astro.originPathname || Astro.url.pathname).replace(/\/$/, '') || '/';
const shareUrl = `${siteUrl}${originPath}`;
const hasAudio = Boolean(data.audioUrl);
const faqs = copy?.faqs ?? [];

const seoTitle = lang === 'hi'
  ? `${localTitle} — हिन्दी पाठ | Online Chalisa`
  : `${localTitle} Lyrics in Hindi | Online Chalisa`;
const seoDescription = copy?.description
  ?? `${data.description} Read it in Devanagari with Telugu, Kannada, Tamil and Bengali scripts${hasAudio ? ', and listen to a spoken recitation that follows each line' : ''}. Free and ad-free.`;
const seoKeywords = [
  data.title,
  `${data.title} lyrics`,
  `${data.title} in hindi`,
  `${data.title} paath`,
  `${data.deity} paath`,
  `${data.title} audio`,
].join(', ');

const lastModified = `${CONTENT_UPDATED}T00:00:00.000Z`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Paath', item: siteUrl + '/#paath' },
      { '@type': 'ListItem', position: 3, name: localTitle, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: localTitle,
    headline: localTitle,
    description: seoDescription,
    inLanguage: 'hi',
    url,
    dateModified: lastModified,
    keywords: seoKeywords,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.paath-answer', '.reader h1', '.verse-line'],
    },
    about: {
      '@type': 'Thing',
      name: data.deity,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'Online Chalisa',
      url: siteUrl + '/',
    },
    ...(data.audioUrl
      ? {
          audio: {
            '@type': 'AudioObject',
            contentUrl: data.audioUrl,
            name: `${localTitle} — audio recitation`,
          },
        }
      : {}),
  },
];

if (faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  image={`/og/${data.slug}.png`}
  shareTitle={localTitle}
  shareDescription={localTagline}
  ogType="article"
  jsonLd={jsonLd}
>
  <Header />

  <main id="main" class="pb-40">
    <ReaderControls slug={data.slug} audioUrl={data.audioUrl} />

    <article class="reader mx-auto max-w-2xl px-4 pt-8 sm:px-6 sm:pt-14">
      <header class="mb-8 text-center">
        <div class="mb-5 flex justify-center">
          <DeityMark deity={data.deity} />
        </div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">
          {localTradition}
        </p>
        <h1
          class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-(--ink) sm:text-5xl"
        >
          {localTitle}
        </h1>
        <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-(--body)">
          {localTagline}
        </p>
        <div class="mx-auto mt-8 h-px w-16 bg-(--hairline)" aria-hidden="true"></div>
      </header>

      {
        copy && opening && (
          <section class="paath-answer mb-12 text-center" aria-label={t('paath.introLabel')}>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">
              {t('paath.introLabel')}
            </p>
            <p class="mx-auto mt-3 max-w-lg text-left text-[15px] leading-relaxed text-(--body) sm:text-center">
              {copy.intro}
            </p>
            <p class="mt-5 font-serif text-lg leading-relaxed text-(--ink)" lang="hi">{opening.hi}</p>
            <p class="mt-1 text-sm italic leading-relaxed text-(--body)" lang="en">{romanize(opening.hi)}</p>
            <p class="mx-auto mt-3 max-w-md text-[12px] leading-relaxed text-(--mute)">{t('paath.romanNote')}</p>
          </section>
        )
      }

      <ol class="space-y-6 text-center" role="list">
        {
          data.verses.map((v, i) => (
            <li
              class="verse group relative"
              id={`v-${i}`}
              data-type={v.type}
              aria-label={`Line ${i + 1}`}
            >
              <div class="flex flex-col items-center gap-1.5">
                {scripts.map((s) => (
                  <p class:list={['verse-line', s.klass]} data-script={s.code} lang={s.code}>
                    {s.text(v.hi)}
                  </p>
                ))}
                <p class="verse-line script-en" data-script="en" lang="en">
                  {romanize(v.hi)}
                </p>
              </div>
              {v.n > 0 && (
                <span
                  class="absolute -left-8 top-2 hidden font-mono text-[10px] text-(--mute) sm:block"
                  aria-hidden="true"
                >
                  {String(v.n).padStart(2, '0')}
                </span>
              )}
            </li>
          ))
        }
      </ol>

      <footer class="mt-16 border-t border-(--hairline) pt-8 text-center">
        <p class="mt-2 text-sm text-(--body)">{t('chalisa.blessing')}</p>

        {
          related.length > 0 && (
            <div class="mt-8">
              <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">
                {t('chalisa.alsoRead')}
              </p>
              <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
                {related.map((item) => (
                  <a
                    href={lp(item.href)}
                    class="inline-flex items-center gap-1.5 rounded-full border border-(--hairline) bg-(--surface) px-4 py-2 text-sm font-medium text-(--ink) transition hover:border-(--hairline-strong)"
                  >
                    {item.label}
                    <Icon name="arrow" size={14} />
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          {
            prev ? (
              <a
                href={lp(`/paath/${prev.data.slug}`)}
                class="inline-flex items-center gap-1.5 rounded-full border border-(--hairline) bg-(--surface) px-4 py-2 text-sm font-medium text-(--ink) transition hover:border-(--hairline-strong)"
              >
                <Icon name="arrow" size={14} class="rotate-180" />
                {titleOf(prev)}
              </a>
            ) : (
              <a
                href={lp('/')}
                class="inline-flex items-center gap-1.5 rounded-full border border-(--hairline) bg-(--surface) px-4 py-2 text-sm font-medium text-(--ink) transition hover:border-(--hairline-strong)"
              >
                <Icon name="arrow" size={14} class="rotate-180" />
                {t('chalisa.home')}
              </a>
            )
          }
          {
            next && (
              <a
                href={lp(`/paath/${next.data.slug}`)}
                class="inline-flex items-center gap-1.5 rounded-full bg-(--ink) px-4 py-2 text-sm font-medium text-(--canvas) transition hover:opacity-90"
              >
                {titleOf(next)}
                <Icon name="arrow" size={14} />
              </a>
            )
          }
        </div>
      </footer>
    </article>

    {
      faqs.length > 0 && (
        <section class="mx-auto mt-16 max-w-2xl px-4 sm:px-6" aria-labelledby="faq-heading">
          <div class="border-t border-(--hairline) pt-12">
            <p class="text-center font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">
              {t('chalisa.faqHeading')}
            </p>
            <h2
              id="faq-heading"
              class="mt-3 text-center font-serif text-2xl font-medium leading-tight tracking-tight text-(--ink) sm:text-3xl"
            >
              {localTitle}
            </h2>
            <p class="mx-auto mt-3 max-w-md text-center text-[15px] leading-relaxed text-(--body)">
              {t('paath.faqSubtitle')}
            </p>
            <div class="mx-auto mt-8 h-px w-16 bg-(--hairline)" aria-hidden="true" />
            <div class="mt-10 space-y-3">
              {faqs.map((f, i) => (
                <details
                  class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)"
                  open={i === 0}
                >
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
                    <span>{f.q}</span>
                    <span
                      class="faq-toggle mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-(--hairline) text-(--mute) transition"
                      aria-hidden="true"
                    />
                  </summary>
                  <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <RecitationNext nextHref={lp(continueTo.href)} nextLabel={continueTo.label} />
  </main>

  <ShareWhatsApp title={localTitle} blurb={localTagline} url={shareUrl} />
  <AudioPlayer title={localTitle} slug={data.slug} audioUrl={data.audioUrl} />

  <Footer />
</Layout>

<script is:inline>
  (function () {
    const KEY = 'oc-sankalp-v1';
    let notified = false;
    function onScroll() {
      if (notified) return;
      const total = document.body.scrollHeight - window.innerHeight;
      if (total <= 0) return;
      if (window.scrollY / total >= 0.8) {
        notified = true;
        try {
          const raw = localStorage.getItem(KEY);
          const s = raw ? JSON.parse(raw) : { length: 11, days: {} };
          const t = new Date().toISOString().slice(0, 10);
          if (!s.days[t]) {
            s.days[t] = true;
            localStorage.setItem(KEY, JSON.stringify(s));
          }
        } catch (e) {}
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
