---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, localizePath } from '../i18n/utils';

const lastUpdated = 'July 2026';
const lp = (p: string) => localizePath(p, getLang(Astro));
---

<Layout
  title="Terms & Conditions · Online Chalisa"
  description="The simple terms that govern your use of Online Chalisa — a free, ad-free devotional reader."
>
  <Header />

  <main id="main" class="pb-24">
    <article class="mx-auto max-w-2xl px-5 pt-16 sm:px-6 sm:pt-24">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">Terms &amp; Conditions</p>
      <h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight text-(--ink) sm:text-5xl">
        A gentle agreement.
      </h1>
      <p class="mt-4 text-sm text-(--mute)">Last updated: {lastUpdated}</p>

      <div class="reader mt-8 space-y-6 text-(--body)">
        <p>
          Online Chalisa is offered freely to devotees around the world. By using this website,
          you agree to the modest terms below. If any of them do not sit right with you, please
          simply do not use the site.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Use of the site</h2>
        <p>
          Online Chalisa is provided free of charge for personal, non-commercial devotional use.
          You are welcome to read, recite, print for personal use, and share links to any page.
          You may not scrape the site to rebuild a competing reader, republish the compiled
          content on another site as your own, or use the site's name and branding in a way that
          suggests endorsement.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Sacred texts</h2>
        <p>
          The Chalisas presented here — the Hanuman Chalisa, Shiv Chalisa, Ganesh Chalisa, Durga
          Chalisa, Shani Chalisa, Laxmi Chalisa and Saraswati Chalisa — are part of a shared
          devotional heritage and are not copyrighted works. The original Devanagari verses
          belong to the tradition. The transliterations into Telugu, Tamil, Kannada and English
          have been prepared with care but are offered as-is; if you notice an error, please let
          us know so we can correct it.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Site design and code</h2>
        <p>
          The design, layout, illustrations, source code, and typography of Online Chalisa are
          the work of its maintainers and are not placed in the public domain. Please do not copy
          the site's design or code wholesale for another project without permission.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Audio recitations</h2>
        <p>
          Where audio is provided, it is an AI-voiced recitation generated by Online Chalisa from the
          traditional text, offered for personal listening alongside the reader. Please do not
          redistribute the audio files without permission.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Sankalp streak</h2>
        <p>
          The Sankalp streak tracker is a personal reminder tool. It lives entirely in your
          browser and has no legal or spiritual authority — a broken streak is not a broken vow,
          and a completed streak is not a certificate. Your practice is between you and the
          divine.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">No warranty</h2>
        <p>
          Online Chalisa is provided <em>as is</em>, without warranty of any kind. We make every
          effort to keep the text accurate and the site available, but we cannot guarantee that
          the site will always be online, error-free, or free from typographical mistakes. Use of
          the site is at your own discretion.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">External links</h2>
        <p>
          The site may occasionally link to external resources — font providers, audio hosts,
          reference material. We are not responsible for the content, availability, or privacy
          practices of any third-party site.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Changes</h2>
        <p>
          These terms may be updated from time to time. Any change will be reflected on this page
          along with a revised date at the top. Continued use of the site after changes are
          posted constitutes acceptance of the updated terms.
        </p>

        <h2 class="pt-4 font-serif text-2xl font-medium text-(--ink)">Contact</h2>
        <p>
          Questions about these terms can be directed via the{' '}
          <a class="underline decoration-(--hairline-strong) underline-offset-4 hover:text-(--ink)" href={lp('/about')}>About page</a>.
        </p>

        <p class="pt-4 text-center font-serif text-lg text-(--ink)">
          ॥ शुभम् अस्तु ॥
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
