---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChalisaCard from '../components/ChalisaCard.astro';
import StreakTracker from '../components/StreakTracker.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);

const entries = (await getCollection('chalisas')).sort(
  (a, b) => a.data.order - b.data.order,
);

const siteUrl = 'https://onlinechalisa.com';

const seoTitle = t('meta.home.title');
const seoDescription = t('meta.home.description');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Online Chalisa',
    alternateName: ['Hanuman Chalisa Online', 'Shri Hanuman Chalisa Reader'],
    url: siteUrl + '/',
    description: seoDescription,
    inLanguage: ['en', 'hi', 'te', 'kn', 'ta', 'bn'],
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: siteUrl + '/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Online Chalisa',
      url: siteUrl + '/',
      logo: {
        '@type': 'ImageObject',
        url: siteUrl + '/apple-touch-icon.png',
        width: 512,
        height: 512,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Chalisa library',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: entries.length,
    itemListElement: entries.map((e, i) => {
      const k = `chalisa.title.${e.data.slug}`;
      return {
        '@type': 'ListItem',
        position: i + 1,
        url: `${siteUrl}/chalisa/${e.data.slug}`,
        name: t(k) === k ? e.data.title : t(k),
      };
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a Chalisa?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A Chalisa is a devotional Hindu hymn of forty verses ("chalis" means forty in Hindi) composed in praise of a deity. The most well-known is the Hanuman Chalisa by Goswami Tulsidas; other widely recited Chalisas honour Shiva, Ganesha, Durga, Shani, Lakshmi and Saraswati.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the Hanuman Chalisa?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Hanuman Chalisa is a 40-verse devotional hymn composed by Goswami Tulsidas in the 16th century in the Awadhi language, praising Lord Hanuman — the immortal devotee of Shri Ram — for his strength, wisdom and boundless bhakti.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I use this site?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Pick any Chalisa from the library. Inside the reader, use the toolbar to switch between Hindi, Telugu, Tamil, Kannada, Bengali and English scripts; toggle the "Show English" pill to see Latin transliteration beneath the primary script; tap Auto-scroll for a hands-free teleprompter mode; or tap Zen to hide all chrome. Your preferences (theme, script, font size) are remembered on this device.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I read the Chalisas in Telugu, Kannada, Tamil or Bengali?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Every verse on Online Chalisa is available in Hindi (Devanagari), Telugu, Kannada, Tamil, Bengali and English transliteration. A single tap in the reader switches script; another tap layers the English lyrics beneath your primary script.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is Online Chalisa free? Are there ads?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, completely free. No ads, no account, no newsletter, no tracking. Your Sankalp streak lives in your browser and is never sent to any server. The site works offline once loaded.',
        },
      },
      {
        '@type': 'Question',
        name: 'How many times should I recite the Hanuman Chalisa daily?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Traditional Hanuman Chalisa paath is one recitation each morning, most auspiciously on Tuesdays and Saturdays. Devotees observing a sankalp typically vow 11, 21 or 40 consecutive days — the tracker on this site helps you count.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the Sankalp streak tracker?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A Sankalp is a spiritual resolve — traditionally a commitment to recite a chalisa for 11, 21 or 40 consecutive days. The tracker on this site automatically marks a day complete when you read 80% of any Chalisa page. It lives entirely in your browser; clearing site data clears the record.',
        },
      },
    ],
  },
];
---

<Layout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <Header />

  <main id="main">
    {/* ───────── Hero ───────── */}
    <section class="relative overflow-hidden">
      <div class="halo pointer-events-none absolute inset-0 -z-10 opacity-80" aria-hidden="true"></div>

      <div class="mx-auto max-w-3xl px-4 pb-16 pt-14 text-center sm:px-6 sm:pb-20 sm:pt-24">
        {/* Diya glyph — the single decorative gesture at the top of the page. */}
        <div class="mb-8 flex justify-center" aria-hidden="true">
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-(--accent-soft) text-(--accent) shadow-[0_0_0_1px_var(--hairline)_inset]">
            <img src="/diya.svg" alt="" width="30" height="30" class="opacity-90" />
          </span>
        </div>

        {/* Sanskrit invocation — sets a devotional register instead of a landing-page tone. */}
        <p
          class="mb-4 font-[var(--font-deva)] text-base leading-relaxed text-(--accent) sm:text-lg"
          lang="sa"
        >
          {t('hero.invocation')}
        </p>

        <h1 class="font-serif text-[2.5rem] font-medium leading-[1.05] tracking-tight text-(--ink) sm:text-6xl md:text-7xl">
          {t('hero.title1')}<br class="hidden sm:inline" /> {t('hero.title2')} <em class="text-(--accent) not-italic">{t('hero.titleWord')}</em>.
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-[16px] leading-relaxed text-(--body) sm:text-[17px]">
          {t('hero.subtitle')}
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={lp('/chalisa/hanuman')}
            class="inline-flex w-full max-w-xs items-center justify-center gap-1.5 rounded-full bg-(--ink) px-6 py-3 text-sm font-medium text-(--canvas) transition hover:opacity-90 sm:w-auto"
          >
            {t('hero.ctaPrimary')}
            <Icon name="arrow" size={14} />
          </a>
          <a
            href="#chalisas"
            class="inline-flex w-full max-w-xs items-center justify-center gap-1.5 rounded-full border border-(--hairline) bg-(--surface) px-6 py-3 text-sm font-medium text-(--ink) transition hover:border-(--hairline-strong) sm:w-auto"
          >
            {t('hero.ctaSecondary')}
          </a>
        </div>

        {/* Script chips — subtle proof that regional scripts are first-class. */}
        <div class="mx-auto mt-10 flex max-w-md flex-wrap items-center justify-center gap-2">
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-(--mute)">{t('hero.availableIn')}</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">हिन्दी</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">తెలుగు</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">தமிழ்</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">ಕನ್ನಡ</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">বাংলা</span>
          <span class="inline-flex items-center rounded-full border border-(--hairline) bg-(--surface) px-2.5 py-1 text-xs text-(--body)">English</span>
        </div>
      </div>
    </section>

    {/* ───────── Chalisa grid ───────── */}
    <section id="chalisas" class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('library.kicker')}</p>
          <h2 class="mt-2 font-serif text-3xl font-medium tracking-tight text-(--ink) sm:text-4xl">
            {t('library.heading')}
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-(--body)">
          {t('library.blurb')}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          entries.map((e) => (
            <ChalisaCard
              slug={e.data.slug}
              title={e.data.title}
              deity={e.data.deity}
              tagline={e.data.tagline}
              tradition={e.data.tradition}
              color={e.data.color}
              order={e.data.order}
              verseCount={e.data.verses.length}
            />
          ))
        }
      </div>
    </section>

    {/* ───────── Feature strip ───────── */}
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
      <h2 class="mb-8 text-center font-serif text-3xl font-medium tracking-tight text-(--ink) sm:text-4xl">
        {t('features.heading')}
      </h2>
      <div class="grid gap-4 md:grid-cols-3">
        <article class="surface-card p-6">
          <div class="mb-4 inline-flex h-8 w-8 items-center justify-center rounded-md bg-(--accent-soft) text-(--accent)">
            <Icon name="zen" size={16} />
          </div>
          <h3 class="font-serif text-xl font-medium text-(--ink)">{t('features.zen.title')}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-(--body)">
            {t('features.zen.body')}
          </p>
        </article>
        <article class="surface-card p-6">
          <div class="mb-4 inline-flex h-8 w-8 items-center justify-center rounded-md bg-(--accent-soft) text-(--accent)">
            <Icon name="scroll" size={16} />
          </div>
          <h3 class="font-serif text-xl font-medium text-(--ink)">{t('features.tele.title')}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-(--body)">
            {t('features.tele.body')}
          </p>
        </article>
        <article class="surface-card p-6">
          <div class="mb-4 inline-flex h-8 w-8 items-center justify-center rounded-md bg-(--accent-soft) text-(--accent)">
            <Icon name="sparkle" size={16} />
          </div>
          <h3 class="font-serif text-xl font-medium text-(--ink)">{t('features.sankalp.title')}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-(--body)">
            {t('features.sankalp.body')}
          </p>
        </article>
      </div>
    </section>

    {/* ───────── Sankalp CTA ───────── */}
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
      <StreakTracker />
    </section>

    {/* ───────── Philosophy ───────── */}
    <section class="mx-auto max-w-3xl px-4 pt-24 text-center sm:px-6">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('philosophy.kicker')}</p>
      <p class="mx-auto mt-4 font-serif text-2xl leading-[1.4] tracking-tight text-(--ink) sm:text-3xl">
        {t('philosophy.text')}
        <span class="text-(--accent)"> {t('philosophy.textEm')}</span>
      </p>
    </section>

    {/* ───────── Global FAQ ─────────
        Short, orientation-focused answers to the questions first-time
        visitors ask ("what is a chalisa", "how do I use this site").
        Per-deity FAQs live on each chalisa page. */}
    <section
      id="faq"
      class="mx-auto mt-24 max-w-2xl px-4 sm:px-6"
      aria-labelledby="faq-home-heading"
    >
      <div class="border-t border-(--hairline) pt-16 text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('faq.kicker')}</p>
        <h2
          id="faq-home-heading"
          class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-(--ink) sm:text-4xl"
        >
          {t('faq.heading')}
        </h2>
        <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-(--body)">
          {t('faq.subtitle')}
        </p>
        <div class="mx-auto mt-8 h-px w-16 bg-(--hairline)" aria-hidden="true"></div>
      </div>

      <div class="mt-10 space-y-3 text-left">
        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)" open>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q1')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a1')}</p>
          </div>
        </details>

        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q2')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a2')}</p>
          </div>
        </details>

        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q3')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a3')}</p>
          </div>
        </details>

        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q4')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a4')}</p>
          </div>
        </details>

        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q5')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a5')}</p>
          </div>
        </details>

        <details class="faq-item group rounded-xl border border-(--hairline) bg-(--surface) px-5 py-4 transition hover:border-(--hairline-strong) open:bg-(--surface-soft)">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg leading-snug text-(--ink) [&::-webkit-details-marker]:hidden">
            <span>{t('faq.q6')}</span>
            <span class="faq-toggle mt-1 grid shrink-0 h-6 w-6 place-items-center rounded-full border border-(--hairline) text-(--mute) transition" aria-hidden="true" />
          </summary>
          <div class="mt-3 text-[15px] leading-relaxed text-(--body)">
            <p>{t('faq.a6')}</p>
          </div>
        </details>
      </div>
    </section>

    {/* ───────── SEO / long-form article ───────── */}
    <section
      id="about-online-chalisa"
      class="mx-auto mt-24 max-w-3xl px-4 pb-8 sm:px-6"
      aria-labelledby="about-heading"
    >
      <div class="mb-10 border-t border-(--hairline) pt-16 text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('home.about.kicker')}</p>
        <h2
          id="about-heading"
          class="mt-2 font-serif text-3xl font-medium tracking-tight text-(--ink) sm:text-4xl"
        >
          {t('home.about.heading')}
        </h2>
      </div>

      <div class="prose-oc space-y-5 text-[15.5px] leading-[1.75] text-(--body)">
        <p>{t('article.p1')}</p>

        <h3 class="font-serif text-xl font-medium text-(--ink)">{t('article.h1')}</h3>
        <p>{t('article.p2')}</p>

        <h3 class="font-serif text-xl font-medium text-(--ink)">{t('article.h2')}</h3>
        <p>{t('article.p3')}</p>

        <p>{t('article.p4')}</p>

        <h3 class="font-serif text-xl font-medium text-(--ink)">{t('article.h3')}</h3>
        <p>{t('article.p5')}</p>

        <h3 class="font-serif text-xl font-medium text-(--ink)">{t('article.h4')}</h3>
        <p>{t('article.p6')}</p>

        <p>{t('article.p7')}</p>

        <div class="pt-6 text-center">
          <a
            href={lp('/chalisa/hanuman')}
            class="inline-flex items-center gap-1.5 rounded-full bg-(--ink) px-6 py-3 text-sm font-medium text-(--canvas) transition hover:opacity-90"
          >
            {t('article.cta')}
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
