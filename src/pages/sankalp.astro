---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StreakTracker from '../components/StreakTracker.astro';
import Icon from '../components/Icon.astro';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<Layout
  title={t('sankalp.metaTitle')}
  description={t('sankalp.metaDescription')}
>
  <Header />

  <main id="main" class="pb-24">
    <section class="relative overflow-hidden">
      <div class="halo pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
      <div class="mx-auto max-w-3xl px-4 pb-10 pt-16 text-center sm:px-6 sm:pt-24">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-(--hairline) bg-(--surface) px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-(--body)">
          <Icon name="sparkle" size={12} />
          {t('sankalp.kicker')}
        </p>
        <h1 class="font-serif text-4xl font-medium leading-tight tracking-tight text-(--ink) sm:text-6xl">
          {t('sankalp.heading')}
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-[16px] leading-relaxed text-(--body)">
          {t('sankalp.subtitle')}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 sm:px-6">
      <StreakTracker />
    </section>

    <section class="mx-auto mt-16 max-w-3xl px-4 sm:px-6">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="surface-card p-5">
          <p class="font-serif text-2xl font-medium text-(--ink)">11</p>
          <p class="mt-1 text-sm text-(--body)">{t('sankalp.plan11')}</p>
        </div>
        <div class="surface-card p-5">
          <p class="font-serif text-2xl font-medium text-(--ink)">21</p>
          <p class="mt-1 text-sm text-(--body)">{t('sankalp.plan21')}</p>
        </div>
        <div class="surface-card p-5">
          <p class="font-serif text-2xl font-medium text-(--ink)">40</p>
          <p class="mt-1 text-sm text-(--body)">{t('sankalp.plan40')}</p>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-2xl px-4 text-center sm:px-6">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-(--mute)">{t('sankalp.noteKicker')}</p>
      <p class="mx-auto mt-3 text-[15px] leading-relaxed text-(--body)">
        {t('sankalp.noteBody')}
      </p>
    </section>
  </main>

  <Footer />
</Layout>
